# GEMINI_API_KEY: Required for Gemini AI API calls on the server (/api/chat).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model for emergency assistant responses.
GEMINI_MODEL="gemini-3.8-flash"

# ELEVENLABS_API_KEY: Optional API key for ElevenLabs multilingual voice synthesis (/api/tts).
# When not set, the client gracefully falls back to browser SpeechSynthesis.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Voice ID used for ElevenLabs TTS (eleven_multilingual_v2).
ELEVENLABS_VOICE_ID="Fo1P5yVLG09zFcOP3CtY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive maps and Places API (New).
VITE_GOOGLE_MAPS_API_KEY=""
